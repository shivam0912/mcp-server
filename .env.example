# Public web configuration
NEXT_PUBLIC_MCP_URL=http://localhost:8787/mcp
MCP_URL=http://localhost:8787/mcp
MCP_BACKEND_URL=http://127.0.0.1:8787
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/shivam0912/contextbridge-ai

# Leave empty for loopback-only local development. Set a strong value when hosted.
MCP_API_KEY=

# Optional OpenAI-compatible provider. Without it, the transparent local planner still uses MCP.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini

# Server policy
PORT=8787
ALLOWED_ORIGINS=http://localhost:3000
ADMIN_API_KEY=
MAX_UPLOAD_BYTES=10485760
CONTEXTBRIDGE_DATABASE_PATH=./data/contextbridge.sqlite
CONTEXTBRIDGE_FILES_PATH=./data

# Optional production persistence
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
