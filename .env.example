# Public web configuration
NEXT_PUBLIC_MCP_URL=http://localhost:8787/mcp
MCP_URL=http://localhost:8787/mcp

# Public demo key; replace in production and configure the same value on web/backend
MCP_API_KEY=change-this-for-production

# Optional OpenAI-compatible provider. Without it, the transparent local planner still uses MCP.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini

# Server policy
PORT=8787
ALLOWED_ORIGINS=http://localhost:3000
ADMIN_API_KEY=
MAX_UPLOAD_BYTES=10485760

# Optional production persistence
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
