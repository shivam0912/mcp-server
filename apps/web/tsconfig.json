{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "allowJs": false,
    "isolatedModules": true
  },
  "include": ["next-env.d.ts", "app/**/*.ts", "app/**/*.tsx", "next.config.ts"],
  "exclude": ["node_modules", ".next"]
}
